// E-Commerce Customer Intelligence — measures for aggregate-only CSV tables.
// Import tables using powerbi/README.md. Currency is GBP.

Total Revenue GBP =
SUM ( MonthlyRevenue[revenue] )

Total Invoices =
SUM ( MonthlyRevenue[orders] )

Total Units Sold =
SUM ( MonthlyRevenue[units] )

Average Order Value GBP =
DIVIDE ( [Total Revenue GBP], [Total Invoices] )

Customers =
SUM ( CustomerTypeSummary[customers] )

Repeat Customers =
CALCULATE ( [Customers], CustomerTypeSummary[customer_type] = "Repeat" )

One-Time Customers =
CALCULATE ( [Customers], CustomerTypeSummary[customer_type] = "One-time" )

Repeat Customer Rate =
DIVIDE ( [Repeat Customers], [Customers] )

Customer Lifetime Revenue GBP =
SUM ( CustomerTypeSummary[lifetime_revenue_gbp] )

Segmented Customers =
SUM ( SegmentCounts[customers] )

Country Revenue GBP =
SUM ( CountryPerformance[revenue] )

Country Invoices =
SUM ( CountryPerformance[orders] )

Product Revenue GBP =
SUM ( ProductPerformance[revenue] )

Product Units Sold =
SUM ( ProductPerformance[units_sold] )

Cohort Retention % =
AVERAGE ( CohortRetention[retention_rate] )

Cohort Customers =
SUM ( CohortRetention[customers] )

Inactivity Snapshot Count =
SUM ( InactivityMonthly[snapshot_count] )

Monthly Inactivity Rate =
DIVIDE (
    SUMX (
        InactivityMonthly,
        InactivityMonthly[inactive_share] * InactivityMonthly[snapshot_count]
    ),
    [Inactivity Snapshot Count]
)

Latest Monthly Inactivity Rate =
VAR LatestDate = MAX ( InactivityMonthly[observation_end] )
RETURN
    CALCULATE (
        [Monthly Inactivity Rate],
        InactivityMonthly[observation_end] = LatestDate
    )
